[Unit]
Description=Pocket Wallet — your cards, tickets and IDs
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-wallet
Group=pocket-wallet
ExecStart=/usr/local/bin/pocket-wallet
Environment=DATA_DIR=/var/lib/pocket-wallet
Environment=PORT=8080
Environment=BASE_URL=https://wallet.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-wallet
PrivateTmp=true

[Install]
WantedBy=multi-user.target
